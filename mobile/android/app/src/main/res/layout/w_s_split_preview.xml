<?xml version="1.0" encoding="utf-8"?>
<!-- Preview in the widget picker (sample numbers). Widget 2 · Split in half (frosted white for the sky wallpaper). Ids shared with w_s_glass.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_s_glass_blue"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/calCol" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:background="@drawable/w_s_press_b"
            android:paddingStart="2dp" android:paddingEnd="4dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Calories" android:textColor="#FFC79C" android:textSize="12sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/calNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="815" android:textColor="#FFFFFF" android:textSize="30sp"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" android:includeFontPadding="false"/>
                <TextView android:id="@+id/calUnit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:layout_marginBottom="3dp"
                    android:text="left" android:textColor="#D5E3F2" android:textSize="13sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/calBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
                android:progress="63" android:max="100" android:progressDrawable="@drawable/w_s_bar_cal_b"/>
            <TextView android:id="@+id/calSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="1,385 of 2,200" android:textColor="#D5E3F2" android:textSize="12sp"
                android:maxLines="1"/>
        </LinearLayout>

        <FrameLayout android:layout_width="1dp" android:layout_height="match_parent"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="#33FFFFFF"/>

        <LinearLayout android:id="@+id/stepsCol" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:background="@drawable/w_s_press_b"
            android:paddingStart="2dp" android:paddingEnd="4dp" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Steps" android:textColor="#9BE6B6" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/stepsNum" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="7,571" android:textColor="#FFFFFF" android:textSize="30sp"
                android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" android:includeFontPadding="false"/>
            <ProgressBar android:id="@+id/stepsBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
                android:progress="76" android:max="100" android:progressDrawable="@drawable/w_s_bar_steps_b"/>
            <TextView android:id="@+id/stepsSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="2,429 to go" android:textColor="#D5E3F2" android:textSize="12sp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/logFood" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="10dp" android:background="@drawable/w_s_btn_white">
        <TextView android:id="@+id/logFoodText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center_vertical"
            android:drawableStart="@drawable/w_s_ic_plus_navy" android:drawablePadding="8dp"
            android:text="Log dinner" android:textColor="#14263B" android:textSize="14sp" android:textStyle="bold"/>
    </FrameLayout>
</LinearLayout>
